if(NOT DEFINED APP OR NOT DEFINED PREVIEW)
    message(FATAL_ERROR "APP and PREVIEW paths are required")
endif()
foreach(testPath DSP_TEST QUANTIZE_TEST)
    if(DEFINED ${testPath})
        execute_process(COMMAND "${${testPath}}" RESULT_VARIABLE result TIMEOUT 30)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${testPath} failed: ${result}")
        endif()
    endif()
endforeach()
execute_process(COMMAND "${APP}" --self-test RESULT_VARIABLE testResult TIMEOUT 90)
if(NOT testResult EQUAL 0)
    message(FATAL_ERROR "Virgo Studios engine integration tests failed: ${testResult}")
endif()
if(DEFINED PLUGIN_BINARY)
    get_filename_component(pluginArchitecture "${PLUGIN_BINARY}" DIRECTORY)
    get_filename_component(pluginContents "${pluginArchitecture}" DIRECTORY)
    get_filename_component(pluginBundle "${pluginContents}" DIRECTORY)
    execute_process(COMMAND "${APP}" "--plugin-test=${pluginBundle}" RESULT_VARIABLE pluginResult TIMEOUT 180)
    if(NOT pluginResult EQUAL 0)
        message(FATAL_ERROR "Virgo Studios VST3 integration tests failed: ${pluginResult}")
    endif()
endif()
execute_process(COMMAND "${APP}" "--screenshot=${PREVIEW}" RESULT_VARIABLE previewResult TIMEOUT 30)
if(NOT previewResult EQUAL 0 OR NOT EXISTS "${PREVIEW}")
    message(FATAL_ERROR "Virgo Studios native window failed to render")
endif()
# The legacy native-suite workflow packages executables only. Preserve a small
# image of the real native interface in its build log for release verification.
execute_process(COMMAND powershell -NoProfile -Command
    "Write-Output ('VIRGO_NATIVE_PREVIEW:' + [Convert]::ToBase64String([IO.File]::ReadAllBytes('${PREVIEW}')))")
set(browserPreview "${PREVIEW}.plugins.png")
execute_process(COMMAND "${APP}" "--plugin-browser-screenshot=${browserPreview}"
    RESULT_VARIABLE browserResult TIMEOUT 30)
if(NOT browserResult EQUAL 0 OR NOT EXISTS "${browserPreview}")
    message(FATAL_ERROR "Virgo Studios plugin browser failed to render")
endif()
execute_process(COMMAND powershell -NoProfile -Command
    "Write-Output ('VIRGO_PLUGIN_BROWSER_PREVIEW:' + [Convert]::ToBase64String([IO.File]::ReadAllBytes('${browserPreview}')))")
